alertcondition(hp_up,
     "Forexnotes — BUY Signal",
     "Forexnotes trading view algo: BUY Signal on {{ticker}} [{{interval}}] @ {{close}}")

alertcondition(sc_up,
     "Forexnotes — SELL Signal",
     "Forexnotes trading view algo: SELL Signal on {{ticker}} [{{interval}}] @ {{close}}")

alertcondition(hp_up and vol_spike,
     "Forexnotes — BUY + Volume Spike 🔥",
     "Forexnotes: HIGH CONFIDENCE BUY — Volume Spike on {{ticker}} @ {{close}}")

alertcondition(sc_up and vol_spike,
     "Forexnotes — SELL + Volume Spike 🔥",
     "Forexnotes: HIGH CONFIDENCE SELL — Volume Spike on {{ticker}} @ {{close}}")

alertcondition(hp_up and bull_1D and bull_4H,
     "Forexnotes — BUY Trend Confirmed",
     "Forexnotes: BUY confirmed — Daily & 4H both Bullish on {{ticker}} @ {{close}}")

alertcondition(is_full_moon,
     "Forexnotes — Full Moon Phase",
     "Forexnotes: Full Moon Phase active — heightened volatility possible on {{ticker}}")

alertcondition(bull_impulse,
     "Forexnotes — Bullish Order Block Formed 🟩",
     "Forexnotes: Bullish Order Block detected on {{ticker}} [{{interval}}] @ {{close}}")

alertcondition(bear_impulse,
     "Forexnotes — Bearish Order Block Formed 🟥",
     "Forexnotes: Bearish Order Block detected on {{ticker}} [{{interval}}] @ {{close}}")

alertcondition(i_pred_enable and pred_bull,
     "Forexnotes — Next Candle: Bullish Prediction",
     "Forexnotes: Next candle predicted BULLISH on {{ticker}} [{{interval}}]")

alertcondition(i_pred_enable and pred_bear,
     "Forexnotes — Next Candle: Bearish Prediction",
     "Forexnotes: Next candle predicted BEARISH on {{ticker}} [{{interval}}]")
